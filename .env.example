# Memorable — copy to .env (never commit secrets)
# NVIDIA NIM docs: https://docs.api.nvidia.com/nim/reference/llm-apis

# --- NVIDIA NIM (OpenAI-compatible: POST https://integrate.api.nvidia.com/v1/chat/completions) ---
NVIDIA_API_KEY=nvapi-your-key-here
# Model id = publisher/name from the catalog (NOT meta/llama3-70b — use meta/llama-3.3-70b-instruct)
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
# Timeouts (seconds) — v4-pro and ultra models need NVIDIA_NIM_TIMEOUT_SLOW
# NVIDIA_NIM_TIMEOUT=90
# NVIDIA_NIM_TIMEOUT_FAST=120
# NVIDIA_NIM_TIMEOUT_SLOW=180

# Other NIM choices for memory extraction (live on 2026-11-18):
# NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b          # fastest, short structured output
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b     # strongest fast model on the free tier
# Slow on the free tier (queued, 1-4 min per call): moonshotai/kimi-k3.1-pro, z-ai/glm-5.3-flash

# --- LOCOMO benchmark QA (shorter prompts + longer client timeouts reduce NIM APITimeoutError) ---
# LOCOMO_QA_LLM_TIMEOUT=300
# LOCOMO_QA_LLM_TIMEOUT_NIM_DEFAULT=240
# LOCOMO_QA_CONTEXT_MAX_CHARS=4500
# LOCOMO_QA_CONTEXT_MAX_MEMORIES=10
# LOCOMO_QA_CONTEXT_LINE_MAX_CHARS=380
# LOCOMO_JUDGE_LLM_TIMEOUT=90

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3-flash-preview

# --- Memorable ---
MEMORABLE_EXTRACTION__MODE=hybrid
MEMORABLE_EXTRACTION__ADD_ONLY=false
MEMORABLE_DATABASE__CONNECTION_STRING=sqlite:///memorable.db
# MEMORABLE_LLM__DEFAULT_MODEL=nvidia_nim/nvidia/nemotron-3.5-lightning-30b-a3b
